{
	"name": "log4js-layout-json",
	"description": "Log4js json layout module",
	"version": "0.2.2",
	"license": "Apache-2.0",
	"author": "Filip Seman <filip.seman@pm.me>",
	"funding": "https://github.com/sponsors/xseman",
	"homepage": "https://github.com/xseman/log4js-layout-json#readme",
	"keywords": [
		"logging",
		"log",
		"log4js",
		"log4js-node",
		"layout",
		"json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xseman/log4js-layout-json.git"
	},
	"scripts": {
		"prebuild": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\"",
		"build": "tsc --build",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"typecheck": "tsc --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json",
		"test": "bun test src/ --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"test:watch": "bun test src/ --watch --coverage"
	},
	"peerDependencies": {
		"log4js": ">=6"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^24.13.3",
		"dprint": "~0.57.4",
		"log4js": "^6.9.1",
		"typescript": "~7.0.2"
	},
	"types": "./lib/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"require": "./lib/index.js"
		}
	},
	"files": [
		"lib/**/*.js",
		"lib/**/*.d.ts",
		"!lib/**/*_test*"
	]
}
